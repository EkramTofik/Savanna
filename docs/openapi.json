{
  "openapi": "3.1.0",
  "info": {
    "title": "Savanna Access Kit API",
    "version": "1.0.0",
    "description": "Level 2 integration (REST) for the Savanna Access Kit: accessible lessons, captions, transcripts, offline packs, jobs and verifiable credentials. Browser components send a publishable key (`pk_...`); server-to-server calls use the secret key. Errors are `application/problem+json` (RFC 9457)."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getV1Health",
        "summary": "Health check",
        "tags": [
          "Ops"
        ],
        "responses": {
          "200": {
            "description": "The API is up.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "const": "ok"
                    },
                    "time": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "time"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/v1/lessons": {
      "get": {
        "operationId": "getV1Lessons",
        "summary": "List lessons",
        "tags": [
          "Lessons"
        ],
        "responses": {
          "200": {
            "description": "Published lessons.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "lessons": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "object",
                            "properties": {
                              "en": {
                                "type": "string"
                              },
                              "am": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "en",
                              "am"
                            ],
                            "additionalProperties": false
                          },
                          "durationSec": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "durationSec"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "lessons"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Savanna-Key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "This key is not allowed from this origin.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/v1/lessons/{id}": {
      "get": {
        "operationId": "getV1LessonsId",
        "summary": "Get a lesson manifest",
        "description": "Everything a player needs: media, English and Amharic captions, sign video, audio description, transcript and offline pack. Fields that do not exist for a lesson are null.",
        "tags": [
          "Lessons"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Lesson id, e.g. L-102",
            "schema": {
              "type": "string",
              "description": "Lesson id, e.g. L-102"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The lesson manifest (contract C1).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "title": {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        },
                        "am": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "en",
                        "am"
                      ],
                      "additionalProperties": false
                    },
                    "durationSec": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "media": {
                      "type": "object",
                      "properties": {
                        "video": {
                          "type": "string",
                          "format": "uri"
                        },
                        "audio": {
                          "type": "string",
                          "format": "uri"
                        }
                      },
                      "required": [
                        "video",
                        "audio"
                      ],
                      "additionalProperties": false
                    },
                    "captions": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "lang": {
                            "type": "string",
                            "enum": [
                              "en",
                              "am"
                            ]
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "lang",
                          "url"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "sign": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "url": {
                              "type": "string",
                              "format": "uri"
                            },
                            "offsetMs": {
                              "type": "integer",
                              "minimum": -9007199254740991,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "url",
                            "offsetMs"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "audioDescription": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "audioUrl": {
                              "type": "string",
                              "format": "uri"
                            },
                            "vttUrl": {
                              "type": "string",
                              "format": "uri"
                            },
                            "extended": {
                              "type": "boolean"
                            }
                          },
                          "required": [
                            "audioUrl",
                            "vttUrl",
                            "extended"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "transcript": {
                      "type": "object",
                      "properties": {
                        "url": {
                          "type": "string",
                          "format": "starts_with",
                          "pattern": "^\\/v1\\/.*"
                        }
                      },
                      "required": [
                        "url"
                      ],
                      "additionalProperties": false
                    },
                    "pack": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "manifestUrl": {
                              "type": "string",
                              "format": "starts_with",
                              "pattern": "^\\/v1\\/.*"
                            },
                            "sizeBytes": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            }
                          },
                          "required": [
                            "manifestUrl",
                            "sizeBytes"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "durationSec",
                    "media",
                    "captions",
                    "sign",
                    "audioDescription",
                    "transcript",
                    "pack"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Savanna-Key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "This key is not allowed from this origin.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Unknown lesson."
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/v1/lessons/{id}/captions/{file}": {
      "get": {
        "operationId": "getV1LessonsIdCaptionsFile",
        "summary": "Get a caption file",
        "description": "Redirects to the WebVTT file for the requested language.",
        "tags": [
          "Lessons"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Lesson id, e.g. L-102",
            "schema": {
              "type": "string",
              "description": "Lesson id, e.g. L-102"
            }
          },
          {
            "name": "file",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "en.vtt",
                "am.vtt"
              ]
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the caption file.",
            "headers": {
              "Location": {
                "description": "URL of the WebVTT file",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Savanna-Key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "This key is not allowed from this origin.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No captions in that language."
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/v1/lessons/{id}/transcript": {
      "get": {
        "operationId": "getV1LessonsIdTranscript",
        "summary": "Get a lesson transcript",
        "tags": [
          "Lessons"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Lesson id, e.g. L-102",
            "schema": {
              "type": "string",
              "description": "Lesson id, e.g. L-102"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "schema": {
              "default": "en",
              "type": "string",
              "enum": [
                "en",
                "am"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timed transcript lines.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "lang": {
                      "type": "string",
                      "enum": [
                        "en",
                        "am"
                      ]
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "start": {
                            "type": "number",
                            "minimum": 0
                          },
                          "end": {
                            "type": "number",
                            "minimum": 0
                          },
                          "text": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "start",
                          "end",
                          "text"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "lang",
                    "lines"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the expected shape.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Savanna-Key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "This key is not allowed from this origin.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No transcript in that language."
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      }
    },
    "/v1/preferences": {
      "get": {
        "operationId": "getV1Preferences",
        "summary": "Get a user's saved preferences",
        "tags": [
          "Preferences"
        ],
        "parameters": [
          {
            "name": "X-Savanna-User",
            "in": "header",
            "required": true,
            "description": "Opaque per-user id (16+ characters) issued by the host platform. Treat it like a password; only its hash is stored.",
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 200,
              "description": "Opaque per-user id (16+ characters) issued by the host platform. Treat it like a password; only its hash is stored."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The preferences object ({} if none saved yet).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ui": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "captions": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "sign": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "ad": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "offline": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "jobs": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the expected shape.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid X-Savanna-Key.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "This key is not allowed from this origin.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKey": []
          }
        ]
      },
