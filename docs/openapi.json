                "type": "object",
                "properties": {
                  "ui": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {}
                  },
                  "captions": {
                    "type": "object",
                    "propertyNames": {
