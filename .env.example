DATABASE_URL=postgresql://savanna:savanna@localhost:5432/savanna
REDIS_URL=redis://localhost:6379
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
# --- API deployment settings (configure actual values in the host environment) ---
# SECRET_KEY must be a unique server-side value of at least 16 characters.
# PARTNERS must be JSON with the actual publishable key and exact HTTPS browser origins.
RATE_LIMIT_PER_MIN=120
STORE=memory
# For production, set PUBLIC_BASE_URL to the API HTTPS origin.
# For production credential signing, set ISSUER_PRIVATE_JWK to a generated Ed25519 private JWK JSON value.
# Set PACK_ROOT only when a persistent volume contains <lesson-id>/pack.json files.
