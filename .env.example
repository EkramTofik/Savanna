PORT=4010
STORE=memory
RATE_LIMIT_PER_MIN=120
DATABASE_URL=postgresql://savanna:savanna@localhost:5432/savanna
REDIS_URL=redis://localhost:6379
PUBLIC_BASE_URL=http://localhost:4010

# Optional local paths. Production pack/media files must be included in the image,
# mounted on persistent storage, or hosted at URLs in the lesson manifests.
# MEDIA_ROOT=contracts/fixtures/media
# PACK_ROOT=contracts/fixtures/v1/lessons
# WEB_ROOT=deploy-web

# Configure these in the hosting provider for production; do not commit secrets.
# SECRET_KEY=<generate a unique server-side secret of at least 16 characters>
# PARTNERS=<JSON array of actual publishable keys and exact browser origins>
# PUBLIC_API_KEY=<publishable browser key; set with PUBLIC_BASE_URL if PARTNERS is omitted>
# PUBLIC_BASE_URL=<public HTTPS API origin; Render sets RENDER_EXTERNAL_URL automatically>
# ISSUER_PRIVATE_JWK=<server-only Ed25519 private JWK JSON; required in production>
# NODE_ENV=production
