{
  "name": "sandbox-career",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node harness/server.mjs",
    "dev": "npm run ui",
    "api": "node harness/server.mjs",
    "ui": "concurrently -k -n API,UI \"npm:api\" \"npm:ui-only\"",
    "ui-only": "vite --port 5173 --strictPort",
    "build": "vite build",
    "test": "vite build && playwright test",
    "audio": "tsx scripts/render-audio.ts",
    "audio:azure": "node scripts/render-audio-azure.mjs",
    "audio:google": "node scripts/render-audio-google.mjs",
    "test:api": "tsx --test test/api.test.ts"
  },
  "dependencies": {
    "express": "^4.21.2",
    "lit": "^3.2.1",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "concurrently": "^9.1.0",
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
