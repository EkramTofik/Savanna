{
  "name": "@savanna/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate --schema prisma/schema",
    "db:push": "prisma db push --schema prisma/schema",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema prisma/schema",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.5",
    "express": "^5",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "playwright": "^1.49.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "swagger-ui-dist": "^5.35.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "^2.12.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "vitest": "^5.1.0"
  }
}
